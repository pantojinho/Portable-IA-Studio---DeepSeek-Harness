web/dist/assets/

# portable runtime, engines and models live next to the app but are not source
runtime/
engines/*
!engines/catalog.yaml
models/*
!models/recipes/
!models/recipes/**
projects/
voices/
data/
agent/*
!agent/package.json
!agent/templates/
!agent/templates/**

# misc
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
